rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasAllowedFields() {
      return request.resource.data.keys().hasOnly([
        "showID",
        "shelf",
        "addedAt",
        "updatedAt",
        "name",
        "posterPath",
        "overview"
      ]);
    }

    function hasRequiredFields() {
      return request.resource.data.keys().hasAll([
        "showID",
        "shelf",
        "addedAt",
        "updatedAt",
        "name",
        "overview"
      ]);
    }

    function hasValidPosterPath() {
      return !("posterPath" in request.resource.data)
        || request.resource.data.posterPath == null
        || request.resource.data.posterPath is string;
    }

    function isValidLibraryDoc() {
      return hasAllowedFields()
        && hasRequiredFields()
        && request.resource.data.showID is int
        && request.resource.data.showID > 0
        && request.resource.data.shelf in ["waiting", "watching", "finished"]
        && request.resource.data.addedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.overview is string
        && request.resource.data.overview.size() <= 10000
        && hasValidPosterPath();
    }

    match /users/{userId}/library/{showId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidLibraryDoc();
      allow delete: if isOwner(userId);
    }
  }
}
